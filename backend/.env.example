# Copy to backend/.env and fill in. Never commit the real file.

# LLM for question generation + evaluation (https://console.groq.com/keys)
GROQ_API_KEY=
# Any Groq chat model enabled for your project. gpt-oss models are handled as reasoning models.
GROQ_MODEL=openai/gpt-oss-120b

# Supabase project holding rag_concepts (pgvector) and interviews.
# Use a secret key (sb_secret_…, or the legacy service_role key): it stays on the
# server and is never sent to the browser. Publishable keys are blocked by RLS.
SUPABASE_URL=
SUPABASE_KEY=

# Query embeddings for semantic retrieval (https://aistudio.google.com/apikey).
# EMBED_MODEL must match the model the knowledge base was embedded with.
GEMINI_API_KEY=
EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768

# "supabase" (default) or "local" to keep interviews in backend/.local-data/ while developing
INTERVIEW_STORE=supabase
CORS_ORIGINS=http://localhost:3000
